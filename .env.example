ANTHROPIC_API_KEY=tu_api_key_aqui
# BRIAN_PHONE: tu número real, adonde el bot avisa cuando hay que hacer handoff.
# El nombre del agente de IA ("Valentina") queda fijo en data/sequences.js.
BRIAN_PHONE=549XXXXXXXXXX
DB_PATH=./pulsetrack.db

# Legacy (Baileys, no oficial) — solo si TRANSPORT=baileys
AGENT_PHONE=549XXXXXXXXXX
SESSION_PATH=./sessions

# Transporte de WhatsApp: "kapso" (API Oficial de Meta, default de este proyecto) o "baileys" (legacy, no usar)
TRANSPORT=kapso
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_TEMPLATE_NAME=
KAPSO_DM_TEMPLATE_NAME=
KAPSO_FOLLOWUP_TEMPLATE_NAME=
KAPSO_HANDOFF_TEMPLATE_NAME=
KAPSO_WEBHOOK_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WEBHOOK_PORT=3000
